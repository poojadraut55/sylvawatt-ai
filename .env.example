# SylvaWatt AI — Self-Hosted Distributed Compute & Green AI Network
# Copy to .env and configure values for your environment.
# Zero real secrets are stored in this template.

PORT=8792
HOST=127.0.0.1
NODE_ENV=development

# Data mode: "demo" (safe pre-seeded multi-role walkthrough) or "live"
SW_DATA_MODE=demo

# Telemetry mode: "auto" (uses host OS + Ollama stats, or AI-OS bridge if enabled), "aios", or "simulated"
SW_TELEMETRY_MODE=auto
SW_AIOS_MONITOR_PATH=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Network brokerage economics (defaults calibrated for consumer fairness)
SW_BROKERAGE_FEE_PCT=12
SW_DEFAULT_KWH_RATE_USD=0.14
SW_WATER_SAVED_LITERS_PER_GPU_HR=2.45

# Affiliate & Monetization IDs (replace with your own partner IDs)
SW_AMAZON_AFFILIATE_TAG=sylvawatt-demo-20
SW_SECURITY_PARTNER_CODE=SAFE-DEMO-01
SW_STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
SW_JWT_SECRET=replace_with_random_64_char_secret
